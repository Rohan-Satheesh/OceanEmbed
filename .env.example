# Copy this file to .env and fill in your own credentials.
# .env is git-ignored — never commit real credentials.

# Copernicus Marine Service (https://data.marine.copernicus.eu/)
# Used for SST (OSTIA), SSS (SMAP/SMOS), SSH/SLA (DUACS), GLORYS target.
COPERNICUSMARINE_SERVICE_USERNAME=
COPERNICUSMARINE_SERVICE_PASSWORD=

# NASA Earthdata (https://urs.earthdata.nasa.gov/)
# Used via `earthaccess` for PO.DAAC products: OSCAR (currents), CCMP/ASCAT (winds).
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=

# INCOIS Live Access Server (https://las.incois.gov.in/)
# Used for gridded ARGO independent validation data.
INCOIS_LAS_USERNAME=
INCOIS_LAS_PASSWORD=

# Weights & Biases (optional; free tier). If unset, experiment tracking
# falls back to CSV/JSON logs under training/runs/.
WANDB_API_KEY=
WANDB_PROJECT=oceanembed
